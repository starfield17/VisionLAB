{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labels.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output_index": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "output_index",
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "ontology_id",
    "ontology_version",
    "classes"
  ],
  "additionalProperties": false
}
