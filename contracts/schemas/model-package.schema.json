{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-package.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "task": {
      "const": "object_detection"
    },
    "model": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "config": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "version",
            "config"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifact",
        "format",
        "adapter"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "preprocessing": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "postprocessing": {
      "type": "object",
      "properties": {
        "output_contract": {
          "const": "adapter_detections_v1"
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nms": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "class_aware"
              ]
            },
            "iou_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "mode",
            "iou_threshold"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "output_contract",
        "confidence_threshold",
        "nms"
      ],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "version",
            "artifact"
          ],
          "additionalProperties": false
        },
        "training": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "artifact"
          ],
          "additionalProperties": false
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "artifact"
          ],
          "additionalProperties": false
        },
        "export": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "artifact"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dataset",
        "training",
        "evaluation",
        "export"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "created_at",
    "task",
    "model",
    "labels",
    "preprocessing",
    "postprocessing",
    "trace"
  ],
  "additionalProperties": false
}
