{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "image_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "ontology_id": {
      "type": "string",
      "minLength": 1
    },
    "ontology_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "rejected"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "locate_anything",
            "vlm",
            "human",
            "self_training"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "model_ref": {
          "type": "string",
          "minLength": 1
        },
        "prompt_ref": {
          "type": "string",
          "minLength": 1
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "actor_id",
        "run_id",
        "tool_version"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewer_id",
        "reviewed_at",
        "reason"
      ],
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "class_id",
          "bbox"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "item_id",
    "image_sha256",
    "ontology_id",
    "ontology_version",
    "created_at",
    "status",
    "source",
    "objects"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "self_training"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "experiment_id",
              "model_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "vlm"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "model_ref",
              "prompt_ref"
            ]
          }
        }
      }
    }
  ]
}
