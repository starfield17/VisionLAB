{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detection-event.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "emitted_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "kind",
        "session_id",
        "frame_index"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "package_id",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "bbox",
          "class_id",
          "label",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "captured_at",
    "emitted_at",
    "source",
    "model",
    "image",
    "detections"
  ],
  "additionalProperties": false
}
